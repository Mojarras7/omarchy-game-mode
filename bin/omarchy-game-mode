#!/bin/bash
set -euo pipefail

# Omarchy Immersive Game Mode (Tokyo Twilight)
# Console-like gaming space on Hyprland's special:gaming workspace:
#   - Super + G: Instant toggle (enter Game Mode, or switch smoothly between Game <-> Desktop)
#   - Super + Ctrl + G (--menu): Compact control menu (Performance / Silent / Exit)
#   - Auto-restores your desktop when you exit Steam Big Picture.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/game-mode"
ACTIVE_FILE="$STATE_DIR/active"
LAST_PROFILE_FILE="$STATE_DIR/last_profile"
WATCHER_PID_FILE="$STATE_DIR/watcher.pid"
SPECIAL_WS="gaming"

mkdir -p "$STATE_DIR"

is_active() {
  [[ -f "$ACTIVE_FILE" ]]
}

current_profile() {
  cat "$ACTIVE_FILE" 2>/dev/null || echo "performance"
}

last_profile() {
  cat "$LAST_PROFILE_FILE" 2>/dev/null || echo "performance"
}

is_in_gaming_view() {
  hyprctl monitors -j 2>/dev/null | jq -e --arg ws "special:$SPECIAL_WS" \
    'any(.[]; .focused == true and .specialWorkspace.name == $ws)' >/dev/null 2>&1
}

has_gaming_window() {
  hyprctl clients -j 2>/dev/null | jq -e --arg ws "special:$SPECIAL_WS" \
    'any(.[]; .workspace.name == $ws)' >/dev/null 2>&1
}

has_gamescope() {
  hyprctl clients -j 2>/dev/null | jq -e \
    'any(.[]; (.class // "") | test("^gamescope$"; "i"))' >/dev/null 2>&1
}

has_big_picture() {
  hyprctl clients -j 2>/dev/null | jq -e \
    'any(.[]; (.class == "steam") and ((.title // "") | test("Big Picture"; "i")))' >/dev/null 2>&1
}

has_steam_game() {
  hyprctl clients -j 2>/dev/null | jq -e \
    'any(.[]; (.class // "") | test("^steam_app_"))' >/dev/null 2>&1
}

has_session_window() {
  has_gamescope || has_big_picture || has_steam_game
}

nightlight_is_on() {
  local status
  status=$(omarchy toggle nightlight --status 2>/dev/null || true)
  jq -e '.enabled == true' <<<"$status" >/dev/null 2>&1
}

stay_awake_is_on() {
  local status
  status=$(omarchy toggle idle status 2>/dev/null || true)
  jq -e '.enabled == true' <<<"$status" >/dev/null 2>&1
}

bar_is_hidden() {
  omarchy toggle enabled bar-off >/dev/null 2>&1
}

stop_watcher() {
  if [[ -f "$WATCHER_PID_FILE" ]]; then
    local pid
    pid=$(cat "$WATCHER_PID_FILE" 2>/dev/null || true)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$WATCHER_PID_FILE"
  fi
}

start_watcher() {
  stop_watcher
  (
    # Wait up to 45s for Gamescope, Steam Big Picture, or a Steam game window to appear
    local seen=false
    for _ in $(seq 1 30); do
      [[ -f "$ACTIVE_FILE" ]] || exit 0
      if has_session_window; then
        seen=true
        break
      fi
      sleep 1.5
    done

    [[ "$seen" == "true" ]] || exit 0

    # Once seen, monitor until the gaming session window closes
    local missing_checks=0
    while [[ -f "$ACTIVE_FILE" ]]; do
      sleep 2
      [[ -f "$ACTIVE_FILE" ]] || exit 0
      if has_session_window; then
        missing_checks=0
      else
        missing_checks=$((missing_checks + 1))
        if (( missing_checks >= 2 )); then
          exec "$0" --exit-auto
        fi
      fi
    done
  ) </dev/null >/dev/null 2>&1 &
  echo $! >"$WATCHER_PID_FILE"
}

sync_bar() {
  is_active || return 0
  if is_in_gaming_view; then
    bar_is_hidden || omarchy toggle bar on >/dev/null 2>&1 || true
  else
    if [[ "$(cat "$STATE_DIR/prev_bar_off" 2>/dev/null || echo false)" != "true" ]]; then
      bar_is_hidden && omarchy toggle bar off >/dev/null 2>&1 || true
    fi
  fi
}

show_gaming_view() {
  if ! has_gaming_window; then
    return 1
  fi
  omarchy toggle bar on >/dev/null 2>&1 || true
  if ! is_in_gaming_view; then
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$SPECIAL_WS\")" >/dev/null 2>&1 || true
  fi
}

LOCK_FILE="$STATE_DIR/launching.lock"

launch_gaming_session() {
  # Prevent duplicate launches if Super+G or Home is pressed again while booting
  if [[ -f "$LOCK_FILE" ]]; then
    local lock_age
    lock_age=$(( $(date +%s) - $(stat -c %Y "$LOCK_FILE" 2>/dev/null || echo 0) ))
    if (( lock_age < 30 )); then
      return 0
    fi
  fi
  touch "$LOCK_FILE"

  omarchy osd -m "Opening..." -i "󰊗" -d 4000 >/dev/null 2>&1 || true

  # Clean up any stale gamescope or outside-gamescope Steam so Steam boots inside Gamescope
  if pgrep -x gamescope >/dev/null 2>&1 && ! has_gamescope; then
    pkill -9 -x gamescope 2>/dev/null || true
    sleep 0.3
  fi
  if pgrep -x steam >/dev/null 2>&1 && ! pgrep -x gamescope >/dev/null 2>&1; then
    steam -shutdown >/dev/null 2>&1 || true
    for _ in $(seq 1 24); do
      pgrep -x steam >/dev/null 2>&1 || break
      sleep 0.25
    done
    pkill -x steam 2>/dev/null || true
  fi

  local mon_w mon_h mon_r
  mon_w=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused==true) | .width' | head -n1)
  mon_h=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused==true) | .height' | head -n1)
  mon_r=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused==true) | (.refreshRate | round)' | head -n1)
  mon_w="${mon_w:-1920}"
  mon_h="${mon_h:-1080}"
  mon_r="${mon_r:-60}"

  setsid -f gamescope -e -f -W "$mon_w" -H "$mon_h" -r "$mon_r" -- steam -gamepadui >/dev/null 2>&1 || true
}

ensure_steam_and_show() {
  if has_gaming_window; then
    rm -f "$LOCK_FILE"
    show_gaming_view
    return 0
  fi

  launch_gaming_session

  # Poll until Gamescope lands in special:gaming (up to 35s),
  # refreshing the OSD every ~3.5s so the user always knows it's still loading.
  for i in $(seq 1 140); do
    if has_gaming_window; then
      rm -f "$LOCK_FILE"
      show_gaming_view
      return 0
    fi
    if (( i % 14 == 0 )); then
      omarchy osd -m "Opening..." -i "󰊗" -d 3800 >/dev/null 2>&1 || true
    fi
    sleep 0.25
  done

  rm -f "$LOCK_FILE"
  return 1
}

hide_gaming_view() {
  if is_in_gaming_view; then
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$SPECIAL_WS\")" >/dev/null 2>&1 || true
  fi
  if [[ "$(cat "$STATE_DIR/prev_bar_off" 2>/dev/null || echo false)" != "true" ]]; then
    omarchy toggle bar off >/dev/null 2>&1 || true
  fi
}

apply_power_profile() {
  local profile="$1"
  case "$profile" in
    silent)
      powerprofilesctl set power-saver 2>/dev/null || true
      ;;
    *)
      powerprofilesctl set performance 2>/dev/null || true
      ;;
  esac
}

enter_game_mode() {
  local profile="${1:-$(last_profile)}"

  if ! is_active; then
    # Snapshot current desktop state so we restore it faithfully on exit
    if bar_is_hidden; then echo "true"; else echo "false"; fi >"$STATE_DIR/prev_bar_off"
    if stay_awake_is_on; then echo "true"; else echo "false"; fi >"$STATE_DIR/prev_stay_awake"
    if nightlight_is_on; then echo "true"; else echo "false"; fi >"$STATE_DIR/prev_nightlight"

    # Immersive environment: mute notifications, prevent lock/screensaver, pause nightlight
    omarchy-shell notifications setDnd on >/dev/null 2>&1 || true
    omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
    omarchy toggle idle stay-awake >/dev/null 2>&1 || true
    if [[ "$(cat "$STATE_DIR/prev_nightlight")" == "true" ]]; then
      omarchy toggle nightlight >/dev/null 2>&1 || true
    fi
  fi

  apply_power_profile "$profile"
  echo "$profile" >"$ACTIVE_FILE"
  echo "$profile" >"$LAST_PROFILE_FILE"

  ensure_steam_and_show || true
  start_watcher

  if [[ "$profile" == "silent" ]]; then
    omarchy osd -m "Gaming · Silent" -i "󰌪" >/dev/null 2>&1 || true
  else
    omarchy osd -m "Gaming" -i "󰊗" >/dev/null 2>&1 || true
  fi
}

exit_game_mode() {
  local close_steam="${1:-true}"

  stop_watcher

  if is_in_gaming_view; then
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$SPECIAL_WS\")" >/dev/null 2>&1 || true
  fi

  if [[ "$close_steam" == "true" ]]; then
    steam -shutdown >/dev/null 2>&1 || true
    for _ in $(seq 1 12); do
      pgrep -x gamescope >/dev/null 2>&1 || break
      sleep 0.25
    done
    pkill -x gamescope 2>/dev/null || true
    pkill -x steam 2>/dev/null || true
  else
    # Auto-exit (e.g. closed Gamescope with Super+Q): make sure Steam also shuts down cleanly
    if pgrep -x steam >/dev/null 2>&1; then
      steam -shutdown >/dev/null 2>&1 || true
    fi
  fi
  rm -f "$LOCK_FILE"

  powerprofilesctl set balanced 2>/dev/null || true
  omarchy-shell notifications setDnd off >/dev/null 2>&1 || true
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true

  if [[ "$(cat "$STATE_DIR/prev_bar_off" 2>/dev/null || echo false)" != "true" ]]; then
    omarchy toggle bar off >/dev/null 2>&1 || true
  fi

  if [[ "$(cat "$STATE_DIR/prev_stay_awake" 2>/dev/null || echo false)" != "true" ]]; then
    omarchy toggle idle allow-idle >/dev/null 2>&1 || true
  fi

  if [[ "$(cat "$STATE_DIR/prev_nightlight" 2>/dev/null || echo false)" == "true" ]]; then
    if ! nightlight_is_on; then
      omarchy toggle nightlight >/dev/null 2>&1 || true
    fi
  fi

  rm -f "$ACTIVE_FILE" "$STATE_DIR/prev_bar_off" "$STATE_DIR/prev_stay_awake" "$STATE_DIR/prev_nightlight"

  omarchy osd -m "Desktop" -i "󰍹" >/dev/null 2>&1 || true
}

smart_toggle() {
  if ! is_active; then
    enter_game_mode "$(last_profile)"
  elif is_in_gaming_view; then
    hide_gaming_view
    omarchy osd -m "Desktop" -i "󰍹" >/dev/null 2>&1 || true
  else
    ensure_steam_and_show || true
    start_watcher
    if [[ "$(current_profile)" == "silent" ]]; then
      omarchy osd -m "Gaming · Silent" -i "󰌪" >/dev/null 2>&1 || true
    else
      omarchy osd -m "Gaming" -i "󰊗" >/dev/null 2>&1 || true
    fi
  fi
}

show_menu() {
  local OPTS=()
  if is_active; then
    if is_in_gaming_view; then
      OPTS+=($'󰍹\tDesktop\tBack to workspace')
    else
      OPTS+=($'󰊗\tGaming\tReturn to game')
    fi

    OPTS+=(
      $'󰓅\tPerformance\tFull power'
      $'󰌪\tSilent\tQuiet fans'
      $'󰈆\tExit\tClose & restore desktop'
    )
  else
    OPTS=(
      $'󰓅\tPerformance\tFull power'
      $'󰌪\tSilent\tQuiet fans'
    )
  fi

  local choice selected
  choice=$(omarchy menu select "Game Mode" "${OPTS[@]}" 2>/dev/null || true)
  [[ -z "$choice" ]] && exit 0

  selected="${choice%%$'\t'*}"

  case "$selected" in
    "Gaming")
      ensure_steam_and_show || true
      ;;
    "Desktop")
      hide_gaming_view
      ;;
    "Performance")
      enter_game_mode "performance"
      ;;
    "Silent")
      enter_game_mode "silent"
      ;;
    "Exit")
      exit_game_mode "true"
      ;;
  esac
}

case "${1:-}" in
  --menu|-m)
    show_menu
    ;;
  --sync-bar)
    sync_bar
    ;;
  --performance)
    enter_game_mode "performance"
    ;;
  --silent)
    enter_game_mode "silent"
    ;;
  --exit)
    exit_game_mode "true"
    ;;
  --exit-auto)
    exit_game_mode "false"
    ;;
  *)
    smart_toggle
    ;;
esac
